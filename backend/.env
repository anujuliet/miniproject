DATABASE_URL=postgres://user:password@host:port/dbname
DB_SSL=true
DB_LOGGING=false

# PostgreSQL Database Config (Local)
DB_NAME=capital_core
DB_USER=myuser
DB_PASS=mypassword
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# SSL Configuration (For Local Use)
DB_SSL=false

# Enable/Disable Logging (true = show queries, false = hide queries)
DB_LOGGING=true

SESSION_SECRET=your_secret_key
PORT=3000
